COMPOSE_PROJECT_NAME=shiguang-demo
# Local override template. Copy this file to .env.local and edit values as needed.
# .env.local is ignored by Git and is loaded by dev, Docker and Alipay sandbox demo scripts.

# Backend
SERVER_PORT=8080
# 模板明确使用本地 dev profile；所有端口映射绑定环回地址。
# 显式设为 prod 时后端按生产语义校验 JWT_SECRET（必须为真实随机密钥）。
SPRING_PROFILES_ACTIVE=dev
# 本地 dev profile 放行此占位密钥并告警；prod profile 会拒绝占位密钥，
# 后端启动直接失败，必须替换为 ≥32 字符的真实随机密钥。
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=120
TRUSTED_PROXIES=172.16.0.0/12
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
PAYMENT_CALLBACK_SECRET=
APP_PAYMENT_DEFAULT_PROVIDER_KEY=payment.dev
APP_PAYMENT_ALIPAY_SANDBOX_ENABLED=false
APP_PAYMENT_ALIPAY_SANDBOX_APP_ID=
APP_PAYMENT_ALIPAY_SANDBOX_APP_PRIVATE_KEY=
APP_PAYMENT_ALIPAY_SANDBOX_ALIPAY_PUBLIC_KEY=
APP_PAYMENT_ALIPAY_SANDBOX_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
APP_PAYMENT_ALIPAY_SANDBOX_NOTIFY_URL=
APP_PAYMENT_ALIPAY_SANDBOX_RETURN_URL=
APP_COMMUNITY_RETENTION_ENABLED=true
APP_COMMUNITY_RETENTION_INITIAL_DELAY_MS=300000
APP_COMMUNITY_RETENTION_FIXED_DELAY_MS=86400000
APP_COMMUNITY_RETENTION_BATCH_SIZE=500
APP_COMMUNITY_RETENTION_MAX_BATCHES_PER_RUN=20
APP_PROVIDER_OBSERVABILITY_SCHEDULED_ENABLED=false
APP_PROVIDER_OBSERVABILITY_SCHEDULER_POOL_SIZE=4
APP_PROVIDER_OBSERVABILITY_WEATHER_ENABLED=false
APP_PROVIDER_OBSERVABILITY_WEATHER_INITIAL_DELAY_MS=60000
APP_PROVIDER_OBSERVABILITY_WEATHER_FIXED_DELAY_MS=900000
APP_PROVIDER_OBSERVABILITY_RISK_ENABLED=true
APP_PROVIDER_OBSERVABILITY_RISK_INITIAL_DELAY_MS=30000
APP_PROVIDER_OBSERVABILITY_RISK_FIXED_DELAY_MS=300000
APP_PROVIDER_OBSERVABILITY_METRICS_ENABLED=true
APP_PROVIDER_OBSERVABILITY_METRICS_INITIAL_DELAY_MS=15000
APP_PROVIDER_OBSERVABILITY_METRICS_FIXED_DELAY_MS=60000
APP_PROVIDER_OBSERVABILITY_RETENTION_ENABLED=true
APP_PROVIDER_OBSERVABILITY_RETENTION_INITIAL_DELAY_MS=300000
APP_PROVIDER_OBSERVABILITY_RETENTION_FIXED_DELAY_MS=86400000
APP_PROVIDER_OBSERVABILITY_RETENTION_SNAPSHOT_DAYS=30
APP_PROVIDER_OBSERVABILITY_RETENTION_CALL_LOG_DAYS=30
APP_PROVIDER_OBSERVABILITY_RETENTION_BATCH_SIZE=500
APP_PROVIDER_OBSERVABILITY_RETENTION_MAX_BATCHES_PER_RUN=20
APP_NOTICE_OUTBOX_POLL_DELAY_MS=5000
APP_NOTICE_OUTBOX_BATCH_SIZE=50
APP_NOTICE_OUTBOX_LEASE_SECONDS=60
APP_NOTICE_OUTBOX_MAX_ATTEMPTS=3
APP_NOTICE_OUTBOX_RETRY_BASE_SECONDS=30
APP_NOTICE_SMTP_ENABLED=false
APP_NOTICE_SMTP_SANDBOX_ONLY=true
APP_NOTICE_SMTP_HOST=127.0.0.1
APP_NOTICE_SMTP_PORT=1025
APP_NOTICE_SMTP_AUTH=false
APP_NOTICE_SMTP_STARTTLS=false
APP_NOTICE_SMTP_USERNAME=
APP_NOTICE_SMTP_PASSWORD=
APP_NOTICE_SMTP_FROM_ADDRESS=no-reply@venue.local
APP_NOTICE_SMTP_FROM_NAME="Venue Reservation Sandbox"
APP_NOTICE_SMTP_CONNECT_TIMEOUT_MS=3000
APP_NOTICE_SMTP_READ_TIMEOUT_MS=5000
APP_NOTICE_SMTP_WRITE_TIMEOUT_MS=5000
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/png,image/jpeg,image/webp
RATE_LIMIT_PER_MINUTE=90
APP_LOG_LEVEL=INFO
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_DEMO_LOGIN_PREFILL=false

# MySQL for local backend and Docker host port mapping.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=venue_reservation
MYSQL_USER=venue
MYSQL_PASSWORD=venue_password
MYSQL_ROOT_PASSWORD=root_password

# Redis for local backend and Docker host port mapping.
REDIS_HOST=localhost
REDIS_PORT=6379

# Docker host ports and images.
BACKEND_PORT=8080
NGINX_PORT=8088
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_IMAGE=axllent/mailpit:v1.30.4
NGINX_IMAGE=nginx:1.29-alpine
NODE_IMAGE=node:24-alpine
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-17
JRE_IMAGE=eclipse-temurin:17-jre
